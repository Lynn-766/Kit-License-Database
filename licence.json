    GITHUB LICENSE VERIFIER + REMOTE LOADER
    Roblox Studio
    Version: 1.0
]]

local HttpService = game:GetService("HttpService")

--------------------------------------------------
-- CONFIGURACION
--------------------------------------------------

-- URL RAW DEL SEGUNDO SCRIPT
local REMOTE_SCRIPT_URL =
    "https://raw.githubusercontent.com/USUARIO/REPOSITORIO/main/Main.lua"

-- Carpeta que será eliminada si no existe autorización.
-- Por defecto: el padre del script verificador.
local TARGET_TO_REMOVE = script.Parent

-- Lista de propietarios autorizados.
-- Reemplaza los números por IDs reales de Roblox.

local AUTHORIZED_IDS = {

    100000001,
    100000002,
    100000003,
    100000004,
    100000005,
    100000006,
    100000007,
    100000008,
    100000009,
    100000010,

    100000011,
    100000012,
    100000013,
    100000014,
    100000015,
    100000016,
    100000017,
    100000018,
    100000019,
    100000020,

    100000021,
    100000022,
    100000023,
    100000024,
    100000025,
    100000026,
    100000027,
    100000028,
    100000029,
    100000030,

    100000031,
    100000032,
    100000033,
    100000034,
    100000035,
    100000036,
    100000037,
    100000038,
    100000039,
    100000040,

    100000041,
    100000042,
    100000043,
    100000044,
    100000045,
    100000046,
    100000047,
    100000048,
    100000049,
    100000050,

}

--------------------------------------------------
-- VERIFICADOR
--------------------------------------------------

local function IsAuthorized(ownerId)

    for _, authorizedId in ipairs(AUTHORIZED_IDS) do

        if ownerId == authorizedId then
            return true
        end

    end

    return false
end

--------------------------------------------------
-- IDENTIFICAR PROPIETARIO
--------------------------------------------------

local creatorType = game.CreatorType
local ownerId = game.CreatorId

-- Esta versión admite juegos propiedad de usuarios.
if creatorType ~= Enum.CreatorType.User then

    warn("[LICENSE] Juego propiedad de un grupo.")
    warn("[LICENSE] Esta versión requiere una autorización de grupo separada.")

    if TARGET_TO_REMOVE then
        TARGET_TO_REMOVE:Destroy()
    end

    return
end

--------------------------------------------------
-- COMPROBAR LICENCIA
--------------------------------------------------

if not IsAuthorized(ownerId) then

    warn("[LICENSE] ACCESO DENEGADO")
    warn("[LICENSE] ID no autorizado: " .. tostring(ownerId))

    if TARGET_TO_REMOVE then
        TARGET_TO_REMOVE:Destroy()
    end

    return
end

print("[LICENSE] Propietario autorizado.")
print("[LICENSE] Licencia válida.")

--------------------------------------------------
-- DESCARGAR SEGUNDO SCRIPT
--------------------------------------------------

local success, source = pcall(function()

    return HttpService:GetAsync(REMOTE_SCRIPT_URL)

end)

if not success then

    warn("[LICENSE] No se pudo descargar el script remoto.")
    warn(tostring(source))

    return
end

--------------------------------------------------
-- VALIDAR RESPUESTA
--------------------------------------------------

if type(source) ~= "string" or #source == 0 then

    warn("[LICENSE] El archivo remoto está vacío.")
    return

end

--------------------------------------------------
-- EJECUTAR SCRIPT REMOTO
--------------------------------------------------

-- Requiere LoadStringEnabled habilitado
-- en la configuración del servidor.

if not workspace:GetAttribute("LicenseLoaderEnabled") then
    -- No se utiliza este atributo como autorización.
    -- Solo se continúa con la ejecución normal.
end

local compileSuccess, remoteFunction = pcall(function()

    return loadstring(source)

end)

if not compileSuccess or type(remoteFunction) ~= "function" then

    warn("[LICENSE] Error al compilar el script remoto.")
    warn(tostring(remoteFunction))

    return
end

local executionSuccess, executionError = pcall(remoteFunction)

if not executionSuccess then

    warn("[LICENSE] Error ejecutando el script remoto.")
    warn(tostring(executionError))

    return
end

print("[LICENSE] Script remoto cargado correctamente.")
